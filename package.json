{
	"name": "bun-accountant",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "bun run build:css && bun run --watch src/index.ts",
		"start": "bun run build:css && bun run src/index.ts",
		"build:css": "bun build src/styles.css --outdir public/assets",
		"format": "biome check --write .",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"verify": "bun run format && bun run build:css && bun run typecheck && bun run test"
	},
	"dependencies": {
		"@elysiajs/html": "^1.4.0",
		"@elysiajs/static": "^1.4.9",
		"@picocss/pico": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"elysia": "^1.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@types/bun": "latest",
		"drizzle-kit": "^0.31.10",
		"postgres": "^3.4.9",
		"typescript": "^6.0.3"
	}
}
